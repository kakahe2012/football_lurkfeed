# Site
NEXT_PUBLIC_SITE_URL=https://football.lurkfeed.com

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI (Qwen recommended)
AI_PROVIDER=qwen
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-plus

# Admin —— 后台登录（生产环境必须修改，否则后台锁定 503）
# 生成示例：openssl rand -hex 24
ADMIN_SECRET=change-me-in-production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-in-production

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=feel-football
R2_PUBLIC_URL=

# Google AdSense — see docs/上线清单.md
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-xxxxxxxx
NEXT_PUBLIC_ADSENSE_SLOT_FEED=          # 瀑布流原生广告
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=       # Trending 下方矩形
NEXT_PUBLIC_ADSENSE_SLOT_INLINE=        # 文章文中
NEXT_PUBLIC_ADSENSE_SLOT_STICKY=        # 手机底部（可选）

# Feed: insert ad every N stories (default 6)
NEXT_PUBLIC_FEED_AD_EVERY=6

# Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
