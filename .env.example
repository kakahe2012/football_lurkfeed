# Site
NEXT_PUBLIC_SITE_URL=https://football.lurkfeed.com

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI (Qwen recommended)
AI_PROVIDER=qwen
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-plus

# Admin —— 后台登录（生产环境必须修改，否则后台锁定 503）
# 生成示例：openssl rand -hex 24
ADMIN_SECRET=change-me-in-production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-in-production

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=feel-football
R2_PUBLIC_URL=

# Google AdSense — see docs/SETUP_ADSENSE_GA4.md
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-8307718514196180
NEXT_PUBLIC_ADSENSE_SLOT_FEED=8946548739
NEXT_PUBLIC_ADSENSE_LAYOUT_KEY_FEED=-6t+ed+2i-1n-4w
NEXT_PUBLIC_ADSENSE_SLOT_INLINE=1877057591
NEXT_PUBLIC_ADSENSE_SLOT_STICKY=5394316539
# NEXT_PUBLIC_ADSENSE_STICKY_ENABLED=true   # 恢复首页/文章底部广告时设为 true
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=8862788253
# NEXT_PUBLIC_ADSENSE_TEST=true          # force test ads (auto on in `npm run dev`)

# Feed: insert ad every N stories (default 6)
NEXT_PUBLIC_FEED_AD_EVERY=6

